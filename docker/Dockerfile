# Shared base: datamitsu binary + the wrapper config; writable store dir.
FROM ghcr.io/datamitsu/datamitsu-unstable:unstable-20260607-039bfbe AS dm-base
USER root
RUN mkdir -p /dm /opt/datamitsu-config && chown -R datamitsu:datamitsu /dm /opt/datamitsu-config
USER datamitsu
ENV DATAMITSU_CACHE_DIR=/dm
WORKDIR /opt/datamitsu-config
COPY --chown=datamitsu:datamitsu datamitsu.config.js ./
RUN git init -q .

