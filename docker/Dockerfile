# syntax=docker/dockerfile:1
# GENERATED by `datamitsu devtools dockerfile` — DO NOT EDIT.
# Regenerate after changing the config or bumping the datamitsu version.
# WARNING: base image ghcr.io/datamitsu/datamitsu:0.1.4 is NOT pinned by digest (offline mode (--offline)).

# Shared base: datamitsu binary + writable store dir. Config-free, so config
# edits never invalidate it or anything built FROM it.
FROM ghcr.io/datamitsu/datamitsu:0.1.4 AS dm-base
USER root
RUN mkdir -p /dm /opt/datamitsu-config /slices && chown -R datamitsu:0 /dm /opt/datamitsu-config /slices && chmod -R g=u /dm /opt/datamitsu-config /slices
USER datamitsu
ENV DATAMITSU_CACHE_DIR=/dm
WORKDIR /opt/datamitsu-config

# --- Build env: ARGs promoted to ENV so every install stage inherits them ---
FROM dm-base AS dm-build
ARG DATAMITSU_INSTALL_TIMEOUT="1200"
ENV DATAMITSU_INSTALL_TIMEOUT=$DATAMITSU_INSTALL_TIMEOUT

# --- Config split: one minimal config slice per stage (build-cache isolation) ---
FROM dm-base AS config-split
COPY --chown=datamitsu:datamitsu datamitsu.config.js ./
RUN git init -q . && datamitsu --config /opt/datamitsu-config/datamitsu.config.js devtools split-config --output /slices

# --- Runtime stages (one per managed runtime) ---
FROM dm-build AS rt-go
COPY --link --from=config-split /slices/rt-go.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install --runtime go

FROM dm-build AS rt-jvm
COPY --link --from=config-split /slices/rt-jvm.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install --runtime jvm

FROM dm-build AS rt-node
COPY --link --from=config-split /slices/rt-node.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install --runtime node

FROM dm-build AS rt-uv
COPY --link --from=config-split /slices/rt-uv.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install --runtime uv

# --- App stages (runtime-managed; inherit their runtime stage) ---
FROM rt-go AS app-govulncheck
COPY --link --from=config-split /slices/app-govulncheck.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install govulncheck

FROM rt-node AS app-jscowsay
COPY --link --from=config-split /slices/app-jscowsay.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install jscowsay

FROM rt-jvm AS app-ktlint
COPY --link --from=config-split /slices/app-ktlint.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install ktlint

FROM rt-uv AS app-pycowsay
COPY --link --from=config-split /slices/app-pycowsay.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install pycowsay

# --- Binary stages (one per downloaded binary) ---
FROM dm-build AS app-task
COPY --link --from=config-split /slices/app-task.js /opt/datamitsu-config/datamitsu.config.js
RUN datamitsu --config /opt/datamitsu-config/datamitsu.config.js install task

# --- Final image: assemble per-app store layers ---
FROM dm-base AS final
COPY --chown=datamitsu:datamitsu datamitsu.config.js ./
LABEL org.opencontainers.image.description="Datamitsu configuration package with pre-installed development tools"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.source="https://github.com/shibanet0/datamitsu-config"
LABEL org.opencontainers.image.title="datamitsu-config"
LABEL org.opencontainers.image.url="https://github.com/shibanet0/datamitsu-config"
LABEL org.opencontainers.image.vendor="shibanet0"
COPY --link --from=rt-jvm /dm/store/.runtimes/jvm /dm/store/.runtimes/jvm
COPY --link --from=rt-node /dm/store/.runtimes/node /dm/store/.runtimes/node
COPY --link --from=rt-uv /dm/store/.runtimes/uv /dm/store/.runtimes/uv
COPY --link --from=app-govulncheck /dm/store/.apps/go/govulncheck /dm/store/.apps/go/govulncheck
COPY --link --from=app-jscowsay /dm/store/.apps/node/jscowsay /dm/store/.apps/node/jscowsay
COPY --link --from=app-ktlint /dm/store/.apps/jvm/ktlint /dm/store/.apps/jvm/ktlint
COPY --link --from=app-pycowsay /dm/store/.apps/uv/pycowsay /dm/store/.apps/uv/pycowsay
COPY --link --from=app-pycowsay /dm/store/.uv/python /dm/store/.uv/python
COPY --link --from=app-task /dm/store/.bin/task /dm/store/.bin/task
USER root
RUN find /dm /opt/datamitsu-config -type d -exec chgrp 0 {} + -exec chmod g=u {} +
USER datamitsu
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/datamitsu","--before-config","/opt/datamitsu-config/datamitsu.config.js"]
CMD ["--help"]
