{
  "version": 1,
  "storeRoot": "/dm/store",
  "layers": [
    {
      "subtree": ".runtimes/jvm",
      "kind": "runtime",
      "app": "jvm"
    },
    {
      "subtree": ".runtimes/node",
      "kind": "runtime",
      "app": "node"
    },
    {
      "subtree": ".runtimes/uv",
      "kind": "runtime",
      "app": "uv"
    },
    {
      "subtree": ".apps/go/govulncheck",
      "kind": "app",
      "app": "govulncheck"
    },
    {
      "subtree": ".apps/node/jscowsay",
      "kind": "app",
      "app": "jscowsay"
    },
    {
      "subtree": ".apps/jvm/ktlint",
      "kind": "app",
      "app": "ktlint"
    },
    {
      "subtree": ".apps/uv/pycowsay",
      "kind": "app",
      "app": "pycowsay"
    },
    {
      "subtree": ".uv/python",
      "kind": "uv-python"
    },
    {
      "subtree": ".bin/task",
      "kind": "binary",
      "app": "task"
    }
  ]
}
