{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "noEmit": true,
    "noUncheckedSideEffectImports": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "rootDir": "${configDir}",
    "types": [
      "node"
    ]
  },
  "display": "Next.js app",
  "exclude": [
    "${configDir}/node_modules"
  ],
  "extends": "./base.json",
  "include": [
    "${configDir}",
    "${configDir}/**/*.json",
    "${configDir}/next-env.d.ts",
    "${configDir}/.next/types/**/*.ts"
  ]
}
