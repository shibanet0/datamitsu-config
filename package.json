    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-json-schema-validator": "6.2.0",
    "eslint-plugin-jsonc": "3.1.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.24.0",
